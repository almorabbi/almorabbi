          "end": 13.451
        }
      ]
    },
    {
      "audio": "docs/stories/narration/ar/anbiya_ayyub_older_p2.m4a",
      "text": "وأصابه من ذلك تعبٌ ومشقّة، وألمٌ في جسده وماله وأهله. فصبر على البلاء.",
      "sentences": [
        {
          "from": 0,
          "to": 53,
          "start": 0.0,
          "end": 9.506
        },
        {
          "from": 54,
          "to": 70,
          "start": 9.956,
          "end": 12.259
        }
      ]
    },
    {
      "audio": "docs/stories/narration/ar/anbiya_ayyub_older_p3.m4a",
      "text": "فنادى أيوبُ ربَّه: ﴿أَنِّي مَسَّنِيَ ٱلضُّرُّ وَأَنتَ أَرۡحَمُ ٱلرَّـٰحِمِينَ﴾. وكان صابرًا على البلاء، راجيًا رحمةَ ربه.",
      "sentences": [
        {
          "from": 0,
          "to": 79,
          "start": 0.0,
          "end": 14.296
        },
        {
          "from": 80,
          "to": 121,
          "start": 14.746,
          "end": 20.973
        }
      ]
    },
    {
      "audio": "docs/stories/narration/ar/anbiya_ayyub_older_p4.m4a",
      "text": "فاستجاب اللهُ له، وقال له: ﴿ٱرۡكُضۡ بِرِجۡلِكَۖ هَٰذَا مُغۡتَسَلُۢ بَارِدٞ وَشَرَابٞ﴾. فنبع له من الأرض ماءٌ باردٌ، يشرب منه ويغتسل؛ ليذهب عنه الضرّ والأذى.",
      "sentences": [
        {
          "from": 0,
          "to": 86,
          "start": 0.0,
          "end": 17.442
        },
        {
          "from": 87,
          "to": 156,
          "start": 17.892,
          "end": 28.066
        }
      ]
    },
    {
      "audio": "docs/stories/narration/ar/anbiya_ayyub_older_p5.m4a",
      "text": "وكشف اللهُ عنه ضرَّه، وأكرمه. وردّ عليه ما فقده من أهلٍ وولدٍ ومالٍ مضاعفًا: أهلَه ومثلَهم معهم.",
      "sentences": [
        {
          "from": 0,
          "to": 29,
          "start": 0.0,
          "end": 4.505
        },
        {
          "from": 30,
          "to": 96,
          "start": 4.955,
          "end": 14.696
        }
      ]
    },
    {
      "audio": "docs/stories/narration/ar/anbiya_ayyub_older_p6.m4a",
      "text": "والعبرة في قوله تعالى: ﴿إِنَّا وَجَدۡنَٰهُ صَابِرٗاۚ نِّعۡمَ ٱلۡعَبۡدُ إِنَّهُۥٓ أَوَّابٞ﴾. فقد وجده اللهُ صابرًا على البلاء، رجّاعًا إلى طاعة الله. وكان ما أعطاه الله رحمةً منه، وذكرى لأصحاب العقول السليمة.",
      "sentences": [
