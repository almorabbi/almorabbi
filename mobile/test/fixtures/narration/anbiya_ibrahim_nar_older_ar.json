          "end": 28.047
        }
      ]
    },
    {
      "audio": "docs/stories/narration/ar/anbiya_ibrahim_nar_older_p3.m4a",
      "text": "ولمّا ذهب قومُه، حطّم إبراهيمُ الأصنامَ وجعلها قِطعًا صغيرة، وترك كبيرَها ليرجعوا إليه ويسألوه. فلمّا رجعوا ورأوا أصنامهم محطّمة، جاؤوا بإبراهيم على مرأى من الناس.",
      "sentences": [
        {
          "from": 0,
          "to": 95,
          "start": 0.0,
          "end": 13.147
        },
        {
          "from": 96,
          "to": 163,
          "start": 13.597,
          "end": 21.802
        }
      ]
    },
    {
      "audio": "docs/stories/narration/ar/anbiya_ibrahim_nar_older_p4.m4a",
      "text": "فرجعوا إلى أنفسهم، وظهر لهم ضلالُهم، وسرعان ما عادوا إلى عنادهم. فقال لهم إبراهيم: ﴿أَفَتَعۡبُدُونَ مِن دُونِ ٱللَّهِ مَا لَا يَنفَعُكُمۡ شَيۡـٔٗا وَلَا يَضُرُّكُمۡ﴾. فلمّا بطلت حجّتُهم، أشعلوا نارًا عظيمة ليُحرقوه بها، وألقوه فيها.",
      "sentences": [
        {
          "from": 0,
          "to": 64,
          "start": 0.0,
