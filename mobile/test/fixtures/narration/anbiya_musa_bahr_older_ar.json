        }
      ]
    },
    {
      "audio": "docs/stories/narration/ar/anbiya_musa_bahr_older_p2.m4a",
      "text": "فسار موسى ومن معه في الليل. ولمّا بلغ فرعونَ مسيرُهم، أرسل جنودَه يجمعون جيشَه من مدائن مملكته.",
      "sentences": [
        {
          "from": 0,
          "to": 27,
          "start": 0.0,
          "end": 3.531
        },
        {
          "from": 28,
          "to": 95,
          "start": 3.981,
          "end": 13.784
        }
      ]
    },
    {
      "audio": "docs/stories/narration/ar/anbiya_musa_bahr_older_p3.m4a",
      "text": "فأخرج اللهُ فرعونَ وقومَه من أرضٍ ذاتِ بساتين وعيونِ ماءٍ وكنوز، فلحقوا بموسى ومن معه وقتَ شروق الشمس. فلمّا رأى كلُّ فريقٍ الآخرَ، قال أصحابُ موسى: ﴿إِنَّا لَمُدۡرَكُونَ﴾.",
      "sentences": [
        {
          "from": 0,
          "to": 102,
          "start": 0.0,
          "end": 12.639
        },
        {
          "from": 103,
          "to": 172,
          "start": 13.089,
          "end": 25.698
        }
      ]
    },
    {
      "audio": "docs/stories/narration/ar/anbiya_musa_bahr_older_p4.m4a",
      "text": "فقال لهم موسى: ﴿كَلَّآۖ إِنَّ مَعِيَ رَبِّي سَيَهۡدِينِ﴾. فأوحى اللهُ إلى موسى أن يضرب بعصاه البحر، فضربه فانفلق، فكانت كلُّ قطعةٍ منه كالجبل العظيم.",
      "sentences": [
        {
          "from": 0,
          "to": 58,
          "start": 0.0,
          "end": 14.132
        },
        {
          "from": 59,
          "to": 150,
          "start": 14.582,
          "end": 28.337
        }
      ]
    },
    {
      "audio": "docs/stories/narration/ar/anbiya_musa_bahr_older_p5.m4a",
      "text": "وقرّب اللهُ فرعونَ وقومَه حتى دخلوا البحر، واستمرّ البحرُ منفلقًا حتى عبر موسى ومن معه إلى البرّ. فأنجى اللهُ موسى ومن معه أجمعين.",
      "sentences": [
        {
          "from": 0,
          "to": 97,
          "start": 0.0,
          "end": 14.788
        },
        {
          "from": 98,
          "to": 130,
          "start": 15.238,
          "end": 20.625
        }
      ]
    },
    {
      "audio": "docs/stories/narration/ar/anbiya_musa_bahr_older_p6.m4a",
      "text": "ثم أغرق اللهُ فرعونَ ومن معه حين أطبق البحرُ عليهم. وفي ذلك عبرةٌ عجيبة تدلّ على قدرة الله، ومع هذه العلامة الباهرة ما صار أكثرُ أتباع فرعون مؤمنين. ومن عِبَر هذه الآيات أنّ الله كان مع موسى عليه السلام بالنصر، فهداه لما فيه نجاته ونجاة من معه.",
